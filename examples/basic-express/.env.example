# Copiez ce fichier en .env puis remplacez les valeurs.
# Ne commitez jamais le fichier .env.

# Secret de signature des JWT (au moins 32 octets aléatoires). Générez-le avec :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Utilisateur de démonstration créé au démarrage (stockage en mémoire).
DEMO_USER_EMAIL=alice@example.test
DEMO_USER_PASSWORD=

# Port HTTP (facultatif, 3000 par défaut).
PORT=3000

# Nombre de proxys de confiance devant l'application (load balancer, reverse proxy).
# Laissez 0 si l'application est exposée directement.
TRUST_PROXY_HOPS=0

# Facultatif : URL Redis pour partager les compteurs de rate limiting entre instances.
# REDIS_URL=redis://localhost:6379
