{
  "name": "express-authkit",
  "version": "0.1.0",
  "description": "Moteur d'authentification sécurisé et extensible pour Express.js : Argon2id, JWT (jose), repository utilisateur injectable.",
  "keywords": [
    "express",
    "authentication",
    "auth",
    "jwt",
    "jose",
    "argon2",
    "argon2id",
    "middleware",
    "security",
    "hexagonal"
  ],
  "license": "MIT",
  "author": "Express AuthKit contributors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./express": "./src/adapters/express/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:package": "node scripts/verify-package.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "express": "^5.3.0",
    "globals": "^17.13.0"
  }
}
