{
  "name": "@express-authkit/core",
  "version": "1.0.0",
  "description": "Moteur d'authentification sécurisé et extensible pour Express.js : Argon2id, JWT (jose), repository utilisateur injectable.",
  "keywords": [
    "express",
    "authentication",
    "auth",
    "jwt",
    "jose",
    "argon2",
    "argon2id",
    "middleware",
    "security",
    "hexagonal"
  ],
  "license": "MIT",
  "author": "Express AuthKit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kourouma1/Express-AuthKit.git"
  },
  "homepage": "https://github.com/kourouma1/Express-AuthKit#readme",
  "bugs": {
    "url": "https://github.com/kourouma1/Express-AuthKit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./express": {
      "types": "./types/adapters/express/index.d.ts",
      "default": "./src/adapters/express/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "express-authkit": "bin/express-authkit.js"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:package": "node scripts/verify-package.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "build:types": "node scripts/build-types.js",
    "typecheck": "tsc -p tsconfig.types.json --noEmit --checkJs",
    "prepack": "npm run build:types"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "@types/express": "^4.17.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  },
  "types": "./types/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
